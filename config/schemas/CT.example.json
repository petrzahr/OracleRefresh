{
  "steps": [
    {
      "type": "update",
      "table": "CONFIG",
      "match": [
        {
          "CONFIG_KEY": "API_URL"
        }
      ],
      "set": {
        "CONFIG_VALUE": "https://api-test.example.cz"
      },
      "key": [
        "CONFIG_KEY"
      ]
    },
    {
      "type": "update",
      "table": "CONFIG",
      "match": [
        {
          "CONFIG_KEY": "CALLBACK_URL"
        }
      ],
      "set": {
        "CONFIG_VALUE": "https://callback-test.example.cz",
        "DESCRIPTIONS": "Test callback"
      },
      "key": [
        "CONFIG_KEY"
      ]
    },
    {
      "type": "delete",
      "table": "CONFIG",
      "match": [
        {
          "CONFIG_KEY": "DUAL_USER"
        }
      ],
      "key": [
        "CONFIG_KEY"
      ]
    }
  ]
}
